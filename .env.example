# ========================================================
# ATS Resume Parser & Evaluation Engine Environment Config
# ========================================================
# NOTE: The system runs 100% locally in offline heuristic mode 
# without any keys. To enable LLM extraction, add your key below.

APP_NAME="ATS Resume Parser & Match Engine"
PORT=8000
HOST="0.0.0.0"
DEBUG=false

# Optional TypeSafe API Key for DocJev Packet Splitting & Document Classification
TYPESAFE_API_KEY=""
ENABLE_DOCJEV=true

# Optional LLM API Keys (Leave empty for 100% offline heuristic parser)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

GOOGLE_API_KEY=""
GOOGLE_MODEL="gemini-2.0-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

